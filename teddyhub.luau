-- Bảng tra cứu phụ: tên nhóm -> danh sách key.
function F.by_group()
    local out = {}
    for key, m in pairs(F.meta) do
        out[m.group] = out[m.group] or {}
        table.insert(out[m.group], key)
    end
    for _, list in pairs(out) do
        table.sort(list)
    end
    return out
end

-- In danh mục khi ĐƯỢC GỌI (file không tự chạy).
function F.list()
    local keys = {}
    for k in pairs(F.meta) do
        keys[#keys + 1] = k
    end
    table.sort(keys)
    for _, k in ipairs(keys) do
        local m = F.meta[k]
        print(string.format("[%5d] %-24s %-10s %s", k, m.name, m.group, m.desc))
    end
end

return F
